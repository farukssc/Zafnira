rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Globally Reusable Helpers (Pillar 3 & 10)
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "farukbangla53@gmail.com")
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Integrity Validation Helpers (Pillar 2)
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'createdAt']) && 
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 200 &&
             data.role in ['customer', 'admin'] &&
             (data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
             (data.address == null || (data.address is string && data.address.size() <= 1000));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'stock', 'image', 'category', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 300 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.image is string && data.image.size() <= 10000 &&
             data.category is string && data.category.size() <= 100 &&
             (data.desc == null || (data.desc is string && data.desc.size() <= 5000)) &&
             (data.nameEn == null || (data.nameEn is string && data.nameEn.size() <= 300)) &&
             (data.rating == null || data.rating is number) &&
             (data.reviewsCount == null || data.reviewsCount is number);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'customerName', 'phone', 'address', 'items', 'totalAmount', 'paymentMethod', 'paymentStatus', 'orderStatus', 'trackingNumber', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() <= 300 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.address is string && data.address.size() <= 1000 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.paymentMethod in ['cod', 'bkash', 'nagad', 'rocket', 'upay', 'stripe', 'paypal'] &&
             data.paymentStatus in ['pending', 'completed'] &&
             data.orderStatus in ['pending', 'processing', 'completed', 'cancelled'] &&
             data.trackingNumber is string && data.trackingNumber.size() <= 100;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 300 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 2000 &&
             data.status in ['pending', 'approved'];
    }

    // 4. Match Blocks for Collections (Pillar 1)

    // ADMINS Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // USERS Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && (incoming().role == 'customer' || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && isValidUser(incoming()) && incoming().role == existing().role)
      );
      allow delete: if isAdmin();
    }

    // PRODUCTS Collection
    match /products/{productId} {
      allow read: if true; // Public access
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // ORDERS Collection
    match /orders/{orderId} {
      // Secure List / Get queries (Pillar 8 & 6)
      allow read, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
                    request.auth.uid == incoming().userId && 
                    isValidOrder(incoming()) && 
                    incoming().orderStatus == 'pending' &&
                    incoming().paymentStatus == 'pending' &&
                    incoming().createdAt == request.time;
                    
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && 
          isValidOrder(incoming()) &&
          incoming().orderStatus == 'cancelled' && 
          existing().orderStatus == 'pending' && 
          incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'updatedAt'])
        )
      );
      
      allow delete: if isAdmin();
    }

    // REVIEWS Collection
    match /reviews/{reviewId} {
      // Secure reading: Public gets approved, Admin gets all
      allow read, get, list: if resource.data.status == 'approved' || isAdmin();
      
      allow create: if isSignedIn() && 
                    request.auth.uid == incoming().userId && 
                    isValidReview(incoming()) && 
                    incoming().status == 'pending' &&
                    incoming().createdAt == request.time;
                    
      // Only admins can approve reviews or delete them
      allow update: if isAdmin() && isValidReview(incoming());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // CONFIGS Collection
    match /configs/{configId} {
      allow read: if true; // Public access to theme/banner configs
      allow write: if isAdmin();
    }
  }
}
